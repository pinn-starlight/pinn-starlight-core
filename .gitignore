# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- environments -----------------------------------------------------------
.venv/
.pixi/*
!.pixi/config.toml

# --- build / generated ------------------------------------------------------
# 生成物统一收在 build/ 下（dist/、tmp/、setuptools 工作区、ruff 缓存）。
build/
# 兜底：外部命令仍可能在根目录重建 dist/ 或 tmp/，继续忽略。
dist/

# --- IDE / local assistant files -------------------------------------------
.idea/
.vscode/
.agents/
notebooks/

# --- experiment outputs / runtime logs -------------------------------------
experiments/output/
experiments/outputs/
experiments/outputs-*/
experiments/scripts/legacy
logs/

# --- server transfer packs / figure exports ---------------------------------
/stage11_transfer_archives/
/transfer_forced_reference_*/
/figure_transfer/

# --- data (source package directory is kept) --------------------------------
/data/
/test
!/src/pinn_starlight_core/data/

# --- generated datasets (regenerate from archives; never commit) ------------
# The whole directory is untracked.  The 10.85 GB of synthetic arrays and the
# camera reference candidates are rebuilt by the data generators;
# collections/manifest.csv stays on disk but is no longer versioned.
collections

# --- large local artifacts (untracked; artifacts/README.md stays on disk) ---
artifacts

# --- misc -------------------------------------------------------------------
.DS_Store
.dsh-drop
.dsh
tmp/
*.swp

# --- legacy documentation ---------------------------------------------------
docs/
