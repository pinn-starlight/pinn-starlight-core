   "source": [
    "import torch\n",
    "\n",
    "x = torch.tensor([[1.0, 2.0], [3.0, 4.0]])\n",
    "w = torch.randn(2, 3, requires_grad=True)\n",
    "y = x @ w\n",
    "\n",
    "print(\"结果形状:\", y.shape)\n",
    "print(\"可以求梯度:\", w.requires_grad)\n"
   ],
